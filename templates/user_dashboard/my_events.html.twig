{% extends 'base.html.twig' %}

{% block title %}My Events - LocalEvent{% endblock %}

{% block body %}
<!-- Dashboard Section -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-3 mb-4">
                {% include 'partials/_dashboard_sidebar.html.twig' with {'active': 'my_events'} %}
            </div>
            
            <!-- Main Content -->
            <div class="col-lg-9">
                <!-- Page Header Card -->
                <div class="dashboard-card animate-on-scroll">
                    <div class="dashboard-card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="dashboard-card-title">
                                <i class="bi bi-calendar-check me-2"></i> My Events
                            </h4>
                            <a href="{{ path('event_new') }}" class="btn btn-primary ripple">
                                <i class="bi bi-plus-circle me-1"></i> Create Event
                            </a>
                        </div>
                    </div>
                    <div class="dashboard-card-body">
                        <p class="text-muted">Manage the events you've created and track their status</p>
                    </div>
                </div>
                
                <!-- Events List -->
                <div class="events-list-container mt-5">
                    {% if events|length > 0 %}
                        {% for event in events %}
                            <div class="event-card-horizontal animate-on-scroll delay-{{ loop.index }}" data-event-id="{{ event.id }}">
                                <div class="event-card-horizontal-inner">
                                    <!-- Event Image -->
                                    <div class="event-card-image">
                                        {% if event.image %}
                                            <img src="{{ asset('uploads/events/' ~ event.image) }}" alt="{{ event.title }}" class="object-fit-cover">
                                        {% else %}
                                            <div class="event-card-image-placeholder" style="background: var(--gradient-blue);">
                                                <i class="bi bi-calendar-event"></i>
                                            </div>
                                        {% endif %}
                                    </div>
                                    
                                    <!-- Event Content -->
                                    <div class="event-card-content">
                                        <h4 class="text-gradient-blue">{{ event.title }}</h4>
                                        
                                        <div class="event-card-metadata">
                                            <div class="event-metadata-item">
                                                <i class="bi bi-geo-alt text-primary"></i>
                                                <span>{{ event.location }}</span>
                                            </div>
                                            <div class="event-metadata-item">
                                                <i class="bi bi-calendar-date text-primary"></i>
                                                <span>{{ event.date|date('M d, Y') }} ({{ event.date|date('D') }})</span>
                                            </div>
                                            <div class="event-metadata-item">
                                                <i class="bi bi-tag text-primary"></i>
                                                <span>
                                                    {% if event.categories|length > 0 %}
                                                        {% for category in event.categories %}
                                                            <span class="badge badge-primary me-1">{{ category.name }}</span>
                                                        {% endfor %}
                                                    {% else %}
                                                        <span class="badge badge-secondary">Uncategorized</span>
                                                    {% endif %}
                                                </span>
                                            </div>
                                        </div>
                                        
                                        <div class="event-card-status-actions">
                                            <div class="event-status">
                                                {% if event.getIsApproved %}
                                                    <span class="status-badge status-badge-approved">
                                                        <i class="bi bi-check-circle-fill"></i>
                                                        <span>Approved</span>
                                                    </span>
                                                {% else %}
                                                    <span class="status-badge status-badge-pending">
                                                        <i class="bi bi-clock-fill"></i>
                                                        <span>Pending</span>
                                                    </span>
                                                {% endif %}
                                            </div>
                                            
                                            <!-- Event Actions -->
                                            <div class="event-actions">
                                                <a href="{{ path('event_show', {'id': event.id}) }}" class="btn btn-outline-primary btn-sm action-btn" title="View">
                                                    <i class="bi bi-eye"></i> View
                                                </a>
                                                <a href="{{ path('event_edit', {'id': event.id}) }}" class="btn btn-outline-secondary btn-sm action-btn" title="Edit">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </a>
                                                
                                                <!-- Delete button with confirmation -->
                                                <div class="delete-button-container" style="position: relative;">
                                                    <!-- Regular Delete Button -->
                                                    <button type="button" class="btn btn-outline-danger btn-sm action-btn delete-event-btn" data-event-id="{{ event.id }}">
                                                        <i class="bi bi-trash"></i> Delete
                                                    </button>
                                                    
                                                    <!-- Delete Confirmation Buttons (Hidden by default) -->
                                                    <div class="delete-confirmation-popup" data-event-id="{{ event.id }}">
                                                        <div class="confirmation-message">
                                                            <i class="bi bi-exclamation-triangle-fill"></i> 
                                                            <strong>Delete this event?</strong>
                                                        </div>
                                                        <div class="confirmation-actions">
                                                            <button type="button" class="btn btn-sm btn-outline cancel-delete-btn">
                                                                <i class="bi bi-x-circle"></i> Cancel
                                                            </button>
                                                            <form method="post" action="{{ path('event_delete', {'id': event.id}) }}" class="d-inline">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                                                                <button type="submit" class="btn btn-sm btn-danger confirm-delete-btn">
                                                                    <i class="bi bi-trash"></i> Delete
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="empty-state py-5">
                            <div class="mb-4">
                                <div class="empty-state-icon">
                                    <i class="bi bi-calendar-plus"></i>
                                </div>
                            </div>
                            <h4 class="text-gradient mb-3">You haven't created any events yet</h4>
                            <p class="text-muted mb-4">Start by creating your first event to share with your community</p>
                            <a href="{{ path('event_new') }}" class="btn btn-primary btn-lg ripple">
                                <i class="bi bi-plus-circle me-1"></i> Create Your First Event
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Flash Messages -->
<div class="flash-messages"></div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Add hover effect to event cards
            document.querySelectorAll('.event-card-horizontal').forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-5px)';
                    this.style.boxShadow = 'var(--shadow-lg)';
                });
                
                card.addEventListener('mouseleave', function() {
                    this.style.transform = '';
                    this.style.boxShadow = '';
                });
            });
            
            // Hide all delete confirmations initially
            document.querySelectorAll('.delete-confirmation-popup').forEach(el => {
                el.style.display = 'none';
            });
            
            // Delete button click - show confirmation
            document.querySelectorAll('.delete-event-btn').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.stopPropagation(); // Prevent event bubbling
                    const eventId = this.dataset.eventId;
                    
                    // Create backdrop
                    const backdrop = document.createElement('div');
                    backdrop.className = 'delete-backdrop';
                    document.body.appendChild(backdrop);
                    
                    // Hide any open confirmations first
                    document.querySelectorAll('.delete-confirmation-popup').forEach(el => {
                        el.style.display = 'none';
                    });
                    document.querySelectorAll('.delete-backdrop').forEach(el => {
                        if (el !== backdrop) el.remove();
                    });
                    
                    // Get the confirmation popup
                    const confirmation = document.querySelector(`.delete-confirmation-popup[data-event-id="${eventId}"]`);
                    
                    // Move popup to body to avoid containment issues
                    document.body.appendChild(confirmation);
                    
                    // Position the popup centered on screen
                    confirmation.style.position = 'fixed';
                    confirmation.style.top = '50%';
                    confirmation.style.left = '50%';
                    confirmation.style.transform = 'translate(-50%, -50%)';
                    confirmation.style.zIndex = '10001';
                    confirmation.style.display = 'block';
                    
                    // Add animation
                    confirmation.classList.add('animate__animated', 'animate__fadeIn');
                    
                    // Make sure the elements in the popup are clickable
                    confirmation.querySelectorAll('button, form, a').forEach(el => {
                        el.style.pointerEvents = 'auto';
                    });
                    
                    // Close confirmation when clicking on backdrop
                    backdrop.addEventListener('click', function() {
                        confirmation.classList.add('animate__fadeOut');
                        backdrop.style.opacity = '0';
                        
                        setTimeout(() => {
                            confirmation.style.display = 'none';
                            confirmation.classList.remove('animate__fadeIn', 'animate__fadeOut');
                            backdrop.remove();
                        }, 300);
                    });
                    
                    // Handle Escape key press to close the popup
                    function handleEscKey(e) {
                        if (e.key === 'Escape') {
                            confirmation.classList.add('animate__fadeOut');
                            backdrop.style.opacity = '0';
                            
                            setTimeout(() => {
                                confirmation.style.display = 'none';
                                confirmation.classList.remove('animate__fadeIn', 'animate__fadeOut');
                                backdrop.remove();
                                document.removeEventListener('keydown', handleEscKey);
                            }, 300);
                        }
                    }
                    
                    document.addEventListener('keydown', handleEscKey);
                });
            });
            
            // Cancel button click - hide confirmation
            document.querySelectorAll('.cancel-delete-btn').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.stopPropagation(); // Prevent event bubbling
                    const confirmation = this.closest('.delete-confirmation-popup');
                    const backdrop = document.querySelector('.delete-backdrop');
                    
                    // Animate out the confirmation
                    confirmation.classList.add('animate__fadeOut');
                    if (backdrop) backdrop.style.opacity = '0';
                    
                    // After animation completes, hide confirmation
                    setTimeout(() => {
                        confirmation.style.display = 'none';
                        confirmation.classList.remove('animate__fadeIn', 'animate__fadeOut');
                        if (backdrop) backdrop.remove();
                    }, 300);
                });
            });
            
            // Add ripple effect to buttons
            document.querySelectorAll('.btn').forEach(button => {
                button.addEventListener('click', function(e) {
                    if (!this.classList.contains('delete-event-btn') && !this.classList.contains('cancel-delete-btn')) {
                        const ripple = document.createElement('span');
                        ripple.className = 'ripple-effect';
                        
                        const rect = this.getBoundingClientRect();
                        const size = Math.max(rect.width, rect.height);
                        const x = e.clientX - rect.left - size / 2;
                        const y = e.clientY - rect.top - size / 2;
                        
                        ripple.style.width = ripple.style.height = `${size}px`;
                        ripple.style.left = `${x}px`;
                        ripple.style.top = `${y}px`;
                        
                        this.appendChild(ripple);
                        
                        setTimeout(() => {
                            ripple.remove();
                        }, 600);
                    }
                });
            });
        });
    </script>
    
    <style>
        /* Improved delete confirmation popup styling */
        .delete-confirmation-popup {
            position: fixed;
            background-color: white;
            border-radius: var(--radius-lg);
            border: 3px solid rgba(var(--error-rgb), 0.8);
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.4);
            padding: var(--space-4);
            z-index: 10001;
            width: 320px;
            max-width: 90vw;
            pointer-events: all !important;
            cursor: default;
        }
        
        .dark-theme .delete-confirmation-popup {
            background-color: var(--dark-bg-800);
            border-color: rgba(var(--error-rgb), 0.8);
        }
        
        .confirmation-message {
            display: flex;
            align-items: center;
            gap: var(--space-2);
            color: var(--error);
            margin-bottom: var(--space-3);
            font-size: var(--fs-md);
            font-weight: var(--weight-bold);
            pointer-events: all !important;
        }
        
        .confirmation-message i {
            font-size: 1.5em;
        }
        
        .confirmation-actions {
            display: flex;
            gap: var(--space-3);
            justify-content: flex-end;
            pointer-events: all !important;
        }
        
        .confirmation-actions button {
            font-weight: var(--weight-semibold);
            padding: 0.5rem 1rem;
            pointer-events: all !important;
            cursor: pointer !important;
        }
        
        .confirmation-actions .btn-danger {
            background-color: var(--error);
            border-color: var(--error);
        }
        
        /* Backdrop for the popup */
        .delete-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.6);
            z-index: 10000;
            backdrop-filter: none; /* Removed blur */
            transition: opacity 0.3s ease;
            pointer-events: all !important;
        }
        
        /* Animation enhancements */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translate(-50%, -60%);
            }
            to {
                opacity: 1;
                transform: translate(-50%, -50%);
            }
        }
        
        @keyframes fadeOut {
            from {
                opacity: 1;
                transform: translate(-50%, -50%);
            }
            to {
                opacity: 0;
                transform: translate(-50%, -40%);
            }
        }
        
        /* Fix for pointer events */
        .delete-confirmation-popup * {
            pointer-events: all !important;
        }
        
        .delete-confirmation-popup button,
        .delete-confirmation-popup a,
        .delete-confirmation-popup form {
            cursor: pointer !important;
            pointer-events: all !important;
        }
    </style>
{% endblock %}
