{% extends 'base.html.twig' %}

{% block title %}My Events - LocalEvent{% endblock %}

{% block body %}
    <!-- My Events Header Section -->
    <section class="bg-primary text-white py-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="mb-0">My Events</h1>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <a href="{{ path('event_new') }}" class="btn btn-light">
                        <i class="bi bi-plus-circle me-1"></i> Create Event
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- My Events Content Section -->
    <section class="py-5">
        <div class="container">
            <div class="row">
                <!-- Dashboard Sidebar -->
                <div class="col-lg-3 mb-4 mb-lg-0">
                    <div class="list-group shadow-sm">
                        <a href="{{ path('app_dashboard') }}" class="list-group-item list-group-item-action">
                            <i class="bi bi-speedometer2 me-2"></i> Dashboard
                        </a>
                        <a href="{{ path('app_profile') }}" class="list-group-item list-group-item-action">
                            <i class="bi bi-person me-2"></i> My Profile
                        </a>
                        <a href="{{ path('app_my_events') }}" class="list-group-item list-group-item-action active">
                            <i class="bi bi-calendar-event me-2"></i> My Events
                        </a>
                        <a href="{{ path('app_attending') }}" class="list-group-item list-group-item-action">
                            <i class="bi bi-calendar-check me-2"></i> Events I'm Attending
                        </a>
                        <a href="{{ path('event_new') }}" class="list-group-item list-group-item-action">
                            <i class="bi bi-plus-circle me-2"></i> Create Event
                        </a>
                    </div>
                </div>
                
                <!-- My Events Main Content -->
                <div class="col-lg-9">
                    <div class="card shadow-sm">
                        <div class="card-header">
                            <h5 class="mb-0">Events You've Created</h5>
                        </div>
                        <div class="card-body">
                            {% if events|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Title</th>
                                                <th>Date</th>
                                                <th>Category</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for event in events %}
                                                <tr>
                                                    <td>{{ event.title }}</td>
                                                    <td>{{ event.date|date('M d, Y') }}</td>
                                                    <td>{{ event.category.name }}</td>
                                                    <td>
                                                        {% if event.isApproved %}
                                                            <span class="badge bg-success">Approved</span>
                                                        {% else %}
                                                            <span class="badge bg-warning text-dark">Pending</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <div class="btn-group" role="group">
                                                            <a href="{{ path('event_show', {'id': event.id}) }}" class="btn btn-sm btn-outline-primary">
                                                                <i class="bi bi-eye"></i>
                                                            </a>
                                                            <a href="{{ path('event_edit', {'id': event.id}) }}" class="btn btn-sm btn-outline-secondary">
                                                                <i class="bi bi-pencil"></i>
                                                            </a>
                                                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ event.id }}">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </div>
                                                        
                                                        <!-- Delete Modal -->
                                                        <div class="modal fade" id="deleteModal{{ event.id }}" tabindex="-1" aria-labelledby="deleteModalLabel{{ event.id }}" aria-hidden="true">
                                                            <div class="modal-dialog">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title" id="deleteModalLabel{{ event.id }}">Confirm Delete</h5>
                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        <p>Are you sure you want to delete the event "{{ event.title }}"?</p>
                                                                        <p class="text-danger"><strong>This action cannot be undone.</strong></p>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                        <form method="post" action="{{ path('event_delete', {'id': event.id}) }}">
                                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                                                                            <button type="submit" class="btn btn-danger">Delete Event</button>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="text-center py-4">
                                    <i class="bi bi-calendar-x display-4 text-muted mb-3"></i>
                                    <p class="lead">You haven't created any events yet.</p>
                                    <a href="{{ path('event_new') }}" class="btn btn-primary mt-2">Create Your First Event</a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
