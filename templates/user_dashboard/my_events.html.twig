{% extends 'base.html.twig' %}

{% block title %}My Events - LocalEvent{% endblock %}

{% block body %}
<!-- Dashboard Section -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-3 mb-4">
                {% include 'partials/_dashboard_sidebar.html.twig' with {'active': 'my_events'} %}
            </div>
            
            <!-- Main Content -->
            <div class="col-lg-9">
                <!-- Page Header Card -->
                <div class="card shadow-sm mb-4 border-left-primary">
                    <div class="card-body py-4">
                        <div class="row align-items-center">
                            <div class="col">
                                <h4 class="mb-1 text-primary">My Events</h4>
                                <p class="text-muted mb-0">Manage the events you've created</p>
                            </div>
                            <div class="col-auto">
                                <a href="{{ path('event_new') }}" class="btn btn-primary">
                                    <i class="bi bi-plus-circle me-1"></i> Create Event
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Events List Card -->
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">All Your Events</h5>
                    </div>
                    <div class="card-body">
                        {% if events|length > 0 %}
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Event</th>
                                            <th>Date</th>
                                            <th>Category</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for event in events %}
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        {% if event.image %}
                                                            <div class="event-thumbnail me-3">
                                                                <img src="{{ asset('uploads/events/' ~ event.image) }}" alt="{{ event.title }}" class="rounded" width="40">
                                                            </div>
                                                        {% else %}
                                                            <div class="event-icon me-3 bg-light rounded p-2">
                                                                <i class="bi bi-calendar-event text-primary"></i>
                                                            </div>
                                                        {% endif %}
                                                        <span>{{ event.title }}</span>
                                                    </div>
                                                </td>
                                                <td>{{ event.date|date('M d, Y') }}</td>
                                                <td>
                                                    {% if event.categories|length > 0 %}
                                                        {% for category in event.categories %}
                                                            <span class="badge bg-secondary">{{ category.name }}</span>
                                                            {% if not loop.last %} {% endif %}
                                                        {% endfor %}
                                                    {% else %}
                                                        <span class="badge bg-light text-dark">Uncategorized</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    {% if event.getIsApproved %}
                                                        <span class="badge bg-success">Approved</span>
                                                    {% else %}
                                                        <span class="badge bg-warning text-dark">Pending</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    <div class="btn-group" role="group">
                                                        <a href="{{ path('event_show', {'id': event.id}) }}" class="btn btn-sm btn-outline-primary" title="View">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                        <a href="{{ path('event_edit', {'id': event.id}) }}" class="btn btn-sm btn-outline-secondary" title="Edit">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ event.id }}" title="Delete">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                    
                                                    <!-- Delete Modal -->
                                                    <div class="modal fade" id="deleteModal{{ event.id }}" tabindex="-1" aria-labelledby="deleteModalLabel{{ event.id }}" aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered">
                                                            <div class="modal-content">
                                                                <div class="modal-header bg-danger text-white">
                                                                    <h5 class="modal-title" id="deleteModalLabel{{ event.id }}">Confirm Delete</h5>
                                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                </div>
                                                                <div class="modal-body">
                                                                    <div class="text-center mb-3">
                                                                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
                                                                    </div>
                                                                    <p>Are you sure you want to delete the event <strong>"{{ event.title }}"</strong>?</p>
                                                                    <p class="text-danger"><strong>This action cannot be undone and will remove all event data including attendees.</strong></p>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                    <form method="post" action="{{ path('event_delete', {'id': event.id}) }}">
                                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}">
                                                                        <button type="submit" class="btn btn-danger">Delete Event</button>
                                                                    </form>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <div class="text-center py-5">
                                <div class="mb-4">
                                    <i class="bi bi-calendar-plus text-muted" style="font-size: 4rem;"></i>
                                </div>
                                <h5 class="text-muted mb-3">You haven't created any events yet</h5>
                                <p class="text-muted mb-4">Start by creating your first event to share with your community</p>
                                <a href="{{ path('event_new') }}" class="btn btn-primary">
                                    <i class="bi bi-plus-circle me-1"></i> Create Your First Event
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
