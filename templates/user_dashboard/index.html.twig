{% extends 'base.html.twig' %}

{% block title %}My Dashboard - LocalEvent{% endblock %}

{% block body %}
<!-- Dashboard Section -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-3 mb-4">
                {% include 'partials/_dashboard_sidebar.html.twig' with {'active': 'dashboard'} %}
            </div>
            
            <!-- Main Content -->
            <div class="col-lg-9">
                <!-- Welcome Card -->
                <div class="card shadow-sm mb-4 border-left-primary">
                    <div class="card-body py-4">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <div class="avatar-circle bg-primary text-white">
                                    <i class="bi bi-person-circle fs-1"></i>
                                </div>
                            </div>
                            <div class="col">
                                <h4 class="mb-1">Welcome back, {{ app.user.name }}!</h4>
                                <p class="text-muted mb-0">Here's what's happening with your events</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Stats Cards -->
                <div class="row mb-4">
                    <div class="col-md-4 mb-4 mb-md-0">
                        <div class="card border-left-primary shadow-sm h-100">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col">
                                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                            My Events</div>
                                        <div class="h5 mb-0 font-weight-bold">{{ myEvents|length }}</div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="bi bi-calendar-event fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4 mb-4 mb-md-0">
                        <div class="card border-left-success shadow-sm h-100">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col">
                                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                            Attending</div>
                                        <div class="h5 mb-0 font-weight-bold">{{ attendances|length }}</div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="bi bi-person-check fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="card border-left-info shadow-sm h-100">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col">
                                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                            Next Event</div>
                                        <div class="h5 mb-0 font-weight-bold">
                                            {% set nextEvent = null %}
                                            {% set today = "now"|date("Y-m-d") %}
                                            
                                            {% for event in myEvents %}
                                                {% if event.date|date("Y-m-d") >= today %}
                                                    {% if nextEvent is null or event.date < nextEvent.date %}
                                                        {% set nextEvent = event %}
                                                    {% endif %}
                                                {% endif %}
                                            {% endfor %}
                                            
                                            {% if nextEvent %}
                                                {{ nextEvent.date|date("M d") }}
                                            {% else %}
                                                -
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        <i class="bi bi-calendar-date fa-2x text-gray-300"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- My Events Preview -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">My Events</h5>
                        <a href="{{ path('app_my_events') }}" class="btn btn-sm btn-primary">View All</a>
                    </div>
                    <div class="card-body">
                        {% if myEvents|length > 0 %}
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Title</th>
                                            <th>Date</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for event in myEvents|slice(0, 3) %}
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        {% if event.image %}
                                                            <div class="event-thumbnail me-3">
                                                                <img src="{{ asset('uploads/events/' ~ event.image) }}" alt="{{ event.title }}" class="rounded" width="40">
                                                            </div>
                                                        {% else %}
                                                            <div class="event-icon me-3 bg-light rounded p-2">
                                                                <i class="bi bi-calendar-event text-primary"></i>
                                                            </div>
                                                        {% endif %}
                                                        <span>{{ event.title }}</span>
                                                    </div>
                                                </td>
                                                <td>{{ event.date|date('M d, Y') }}</td>
                                                <td>
                                                    {% if event.getIsApproved %}
                                                        <span class="badge bg-success">Approved</span>
                                                    {% else %}
                                                        <span class="badge bg-warning text-dark">Pending</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    <div class="btn-group">
                                                        <a href="{{ path('event_show', {'id': event.id}) }}" class="btn btn-sm btn-outline-primary" title="View">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                        <a href="{{ path('event_edit', {'id': event.id}) }}" class="btn btn-sm btn-outline-secondary" title="Edit">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <div class="text-center py-4">
                                <div class="mb-3">
                                    <i class="bi bi-calendar-plus text-muted" style="font-size: 3rem;"></i>
                                </div>
                                <p class="text-muted mb-3">You haven't created any events yet.</p>
                                <a href="{{ path('event_new') }}" class="btn btn-primary">
                                    <i class="bi bi-plus-circle me-1"></i> Create Your First Event
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
                
                <!-- Events I'm Attending Preview -->
                <div class="card shadow-sm">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">Events I'm Attending</h5>
                        <a href="{{ path('app_attending') }}" class="btn btn-sm btn-primary">View All</a>
                    </div>
                    <div class="card-body">
                        {% if attendances|length > 0 %}
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Event</th>
                                            <th>Date</th>
                                            <th>Organizer</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for attendance in attendances|slice(0, 3) %}
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        {% if attendance.event.image %}
                                                            <div class="event-thumbnail me-3">
                                                                <img src="{{ asset('uploads/events/' ~ attendance.event.image) }}" alt="{{ attendance.event.title }}" class="rounded" width="40">
                                                            </div>
                                                        {% else %}
                                                            <div class="event-icon me-3 bg-light rounded p-2">
                                                                <i class="bi bi-calendar-event text-primary"></i>
                                                            </div>
                                                        {% endif %}
                                                        <span>{{ attendance.event.title }}</span>
                                                    </div>
                                                </td>
                                                <td>{{ attendance.event.date|date('M d, Y') }}</td>
                                                <td>{{ attendance.event.organizer.name }}</td>
                                                <td>
                                                    <div class="btn-group">
                                                        <a href="{{ path('event_show', {'id': attendance.event.id}) }}" class="btn btn-sm btn-outline-primary" title="View">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Leave" 
                                                                onclick="if(confirm('Are you sure you want to leave this event?')) { document.getElementById('leave-form-{{ attendance.event.id }}').submit(); }">
                                                            <i class="bi bi-x-circle"></i>
                                                        </button>
                                                        <form id="leave-form-{{ attendance.event.id }}" method="post" action="{{ path('event_leave', {'id': attendance.event.id}) }}" class="d-none">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('leave' ~ attendance.event.id) }}">
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <div class="text-center py-4">
                                <div class="mb-3">
                                    <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
                                </div>
                                <p class="text-muted mb-3">You're not attending any events yet.</p>
                                <a href="{{ path('event_index') }}" class="btn btn-primary">
                                    <i class="bi bi-search me-1"></i> Browse Events
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
