{% extends 'base.html.twig' %}

{% block title %}My Dashboard - LocalEvent{% endblock %}

{% block body %}
    <!-- Dashboard Header Section -->
    <section class="bg-primary text-white py-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="mb-0">My Dashboard</h1>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <a href="{{ path('event_new') }}" class="btn btn-light">
                        <i class="bi bi-plus-circle me-1"></i> Create Event
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Dashboard Content Section -->
    <section class="py-5">
        <div class="container">
            <div class="row">
                <!-- Dashboard Sidebar -->
                <div class="col-lg-3 mb-4 mb-lg-0">
                    <div class="list-group shadow-sm">
                        <a href="{{ path('app_dashboard') }}" class="list-group-item list-group-item-action active">
                            <i class="bi bi-speedometer2 me-2"></i> Dashboard
                        </a>
                        <a href="{{ path('app_profile') }}" class="list-group-item list-group-item-action">
                            <i class="bi bi-person me-2"></i> My Profile
                        </a>
                        <a href="{{ path('app_my_events') }}" class="list-group-item list-group-item-action">
                            <i class="bi bi-calendar-event me-2"></i> My Events
                        </a>
                        <a href="{{ path('app_attending') }}" class="list-group-item list-group-item-action">
                            <i class="bi bi-calendar-check me-2"></i> Events I'm Attending
                        </a>
                        <a href="{{ path('event_new') }}" class="list-group-item list-group-item-action">
                            <i class="bi bi-plus-circle me-2"></i> Create Event
                        </a>
                    </div>
                </div>
                
                <!-- Dashboard Main Content -->
                <div class="col-lg-9">
                    <!-- Welcome Card -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <h4 class="card-title">Welcome, {{ app.user.name }}!</h4>
                            <p class="card-text">Manage your events, update your profile, and check the events you're attending - all from your dashboard.</p>
                        </div>
                    </div>
                    
                    <!-- My Events Preview -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">My Events</h5>
                            <a href="{{ path('app_my_events') }}" class="btn btn-sm btn-outline-primary">View All</a>
                        </div>
                        <div class="card-body">
                            {% if myEvents|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Title</th>
                                                <th>Date</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for event in myEvents|slice(0, 3) %}
                                                <tr>
                                                    <td>{{ event.title }}</td>
                                                    <td>{{ event.date|date('M d, Y') }}</td>
                                                    <td>
                                                        {% if event.isApproved %}
                                                            <span class="badge bg-success">Approved</span>
                                                        {% else %}
                                                            <span class="badge bg-warning text-dark">Pending</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <a href="{{ path('event_show', {'id': event.id}) }}" class="btn btn-sm btn-outline-primary">View</a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <p class="text-muted mb-0">You haven't created any events yet.</p>
                                <a href="{{ path('event_new') }}" class="btn btn-primary mt-3">Create Your First Event</a>
                            {% endif %}
                        </div>
                    </div>
                    
                    <!-- Events I'm Attending Preview -->
                    <div class="card shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Events I'm Attending</h5>
                            <a href="{{ path('app_attending') }}" class="btn btn-sm btn-outline-primary">View All</a>
                        </div>
                        <div class="card-body">
                            {% if attendances|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Event</th>
                                                <th>Date</th>
                                                <th>Organizer</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for attendance in attendances|slice(0, 3) %}
                                                <tr>
                                                    <td>{{ attendance.event.title }}</td>
                                                    <td>{{ attendance.event.date|date('M d, Y') }}</td>
                                                    <td>{{ attendance.event.organizer.name }}</td>
                                                    <td>
                                                        <a href="{{ path('event_show', {'id': attendance.event.id}) }}" class="btn btn-sm btn-outline-primary">View</a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <p class="text-muted mb-0">You're not attending any events yet.</p>
                                <a href="{{ path('event_index') }}" class="btn btn-primary mt-3">Browse Events</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
