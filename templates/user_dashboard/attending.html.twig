{% extends 'base.html.twig' %}

{% block title %}Events I'm Attending - LocalEvent{% endblock %}

{% block body %}
    <!-- Attending Events Header Section -->
    <section class="bg-primary text-white py-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="mb-0">Events I'm Attending</h1>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <a href="{{ path('event_index') }}" class="btn btn-light">
                        <i class="bi bi-search me-1"></i> Browse Events
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Attending Events Content Section -->
    <section class="py-5">
        <div class="container">
            <div class="row">
                <!-- Dashboard Sidebar -->
                <div class="col-lg-3 mb-4 mb-lg-0">
                    <div class="list-group shadow-sm">
                        <a href="{{ path('app_dashboard') }}" class="list-group-item list-group-item-action">
                            <i class="bi bi-speedometer2 me-2"></i> Dashboard
                        </a>
                        <a href="{{ path('app_profile') }}" class="list-group-item list-group-item-action">
                            <i class="bi bi-person me-2"></i> My Profile
                        </a>
                        <a href="{{ path('app_my_events') }}" class="list-group-item list-group-item-action">
                            <i class="bi bi-calendar-event me-2"></i> My Events
                        </a>
                        <a href="{{ path('app_attending') }}" class="list-group-item list-group-item-action active">
                            <i class="bi bi-calendar-check me-2"></i> Events I'm Attending
                        </a>
                        <a href="{{ path('event_new') }}" class="list-group-item list-group-item-action">
                            <i class="bi bi-plus-circle me-2"></i> Create Event
                        </a>
                    </div>
                </div>
                
                <!-- Attending Events Main Content -->
                <div class="col-lg-9">
                    <div class="card shadow-sm">
                        <div class="card-header">
                            <h5 class="mb-0">Your Event Registrations</h5>
                        </div>
                        <div class="card-body">
                            {% if attendances|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Event</th>
                                                <th>Date</th>
                                                <th>Category</th>
                                                <th>Organizer</th>
                                                <th>Joined</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for attendance in attendances %}
                                                <tr>
                                                    <td>{{ attendance.event.title }}</td>
                                                    <td>{{ attendance.event.date|date('M d, Y') }}</td>
                                                    <td>{{ attendance.event.category.name }}</td>
                                                    <td>{{ attendance.event.organizer.name }}</td>
                                                    <td>{{ attendance.joinedAt|date('M d, Y') }}</td>
                                                    <td>
                                                        <div class="btn-group" role="group">
                                                            <a href="{{ path('event_show', {'id': attendance.event.id}) }}" class="btn btn-sm btn-outline-primary">
                                                                <i class="bi bi-eye"></i>
                                                            </a>
                                                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#leaveModal{{ attendance.id }}">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        </div>
                                                        
                                                        <!-- Leave Event Modal -->
                                                        <div class="modal fade" id="leaveModal{{ attendance.id }}" tabindex="-1" aria-labelledby="leaveModalLabel{{ attendance.id }}" aria-hidden="true">
                                                            <div class="modal-dialog">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title" id="leaveModalLabel{{ attendance.id }}">Confirm Cancellation</h5>
                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        <p>Are you sure you want to cancel your attendance for "{{ attendance.event.title }}"?</p>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep My Registration</button>
                                                                        <form method="post" action="{{ path('event_leave', {'id': attendance.event.id}) }}">
                                                                            <input type="hidden" name="_token" value="{{ csrf_token('leave' ~ attendance.event.id) }}">
                                                                            <button type="submit" class="btn btn-danger">Cancel Attendance</button>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="text-center py-4">
                                    <i class="bi bi-calendar-x display-4 text-muted mb-3"></i>
                                    <p class="lead">You're not attending any events yet.</p>
                                    <a href="{{ path('event_index') }}" class="btn btn-primary mt-2">Browse Events</a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
