{% extends 'base.html.twig' %}

{% block title %}Events I'm Attending - LocalEvent{% endblock %}

{% block body %}
<!-- Dashboard Section -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-3 mb-4">
                {% include 'partials/_dashboard_sidebar.html.twig' with {'active': 'attending'} %}
            </div>
            
            <!-- Main Content -->
            <div class="col-lg-9">
                <!-- Page Header Card -->
                <div class="card shadow-sm mb-4 border-left-success">
                    <div class="card-body py-4">
                        <div class="row align-items-center">
                            <div class="col">
                                <h4 class="mb-1 text-success">Events I'm Attending</h4>
                                <p class="text-muted mb-0">View all events you've registered for</p>
                            </div>
                            <div class="col-auto">
                                <a href="{{ path('event_index') }}" class="btn btn-success">
                                    <i class="bi bi-search me-1"></i> Browse Events
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Events List Card -->
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">Your Upcoming Events</h5>
                    </div>
                    <div class="card-body">
                        {% if attendances|length > 0 %}
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Event</th>
                                            <th>Date</th>
                                            <th>Categories</th>
                                            <th>Organizer</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for attendance in attendances %}
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        {% if attendance.event.image %}
                                                            <div class="event-thumbnail me-3">
                                                                <img src="{{ asset('uploads/events/' ~ attendance.event.image) }}" alt="{{ attendance.event.title }}" class="rounded" width="40">
                                                            </div>
                                                        {% else %}
                                                            <div class="event-icon me-3 bg-light rounded p-2">
                                                                <i class="bi bi-calendar-event text-success"></i>
                                                            </div>
                                                        {% endif %}
                                                        <span>{{ attendance.event.title }}</span>
                                                    </div>
                                                </td>
                                                <td>{{ attendance.event.date|date('M d, Y') }}</td>
                                                <td>
                                                    {% if attendance.event.categories|length > 0 %}
                                                        {% for category in attendance.event.categories %}
                                                            <span class="badge bg-secondary">{{ category.name }}</span>
                                                            {% if not loop.last %} {% endif %}
                                                        {% endfor %}
                                                    {% else %}
                                                        <span class="badge bg-light text-dark">Uncategorized</span>
                                                    {% endif %}
                                                </td>
                                                <td>{{ attendance.event.organizer.name }}</td>
                                                <td>
                                                    <div class="btn-group">
                                                        <a href="{{ path('event_show', {'id': attendance.event.id}) }}" class="btn btn-sm btn-outline-primary" title="View">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#leaveModal{{ attendance.event.id }}" title="Leave">
                                                            <i class="bi bi-x-circle"></i>
                                                        </button>
                                                    </div>
                                                    
                                                    <!-- Leave Modal -->
                                                    <div class="modal fade" id="leaveModal{{ attendance.event.id }}" tabindex="-1" aria-labelledby="leaveModalLabel{{ attendance.event.id }}" aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered">
                                                            <div class="modal-content">
                                                                <div class="modal-header bg-warning">
                                                                    <h5 class="modal-title" id="leaveModalLabel{{ attendance.event.id }}">Confirm Leave Event</h5>
                                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                </div>
                                                                <div class="modal-body">
                                                                    <div class="text-center mb-3">
                                                                        <i class="bi bi-question-circle-fill text-warning" style="font-size: 3rem;"></i>
                                                                    </div>
                                                                    <p>Are you sure you want to leave the event <strong>"{{ attendance.event.title }}"</strong>?</p>
                                                                    <p class="text-muted">Your registration will be cancelled and you'll need to re-register if you change your mind.</p>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                    <form method="post" action="{{ path('event_leave', {'id': attendance.event.id}) }}">
                                                                        <input type="hidden" name="_token" value="{{ csrf_token('leave' ~ attendance.event.id) }}">
                                                                        <button type="submit" class="btn btn-warning">Leave Event</button>
                                                                    </form>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <div class="text-center py-5">
                                <div class="mb-4">
                                    <i class="bi bi-calendar-check text-muted" style="font-size: 4rem;"></i>
                                </div>
                                <h5 class="text-muted mb-3">You're not attending any events yet</h5>
                                <p class="text-muted mb-4">Browse our event listings and join events you're interested in</p>
                                <a href="{{ path('event_index') }}" class="btn btn-success">
                                    <i class="bi bi-search me-1"></i> Browse Events
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
