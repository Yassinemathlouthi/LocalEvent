{% extends 'base.html.twig' %}

{% block title %}About Us - LocalEvent{% endblock %}

{% block body %}
    <!-- About Hero Section -->
    <section class="bg-primary text-white py-5">
        <div class="container">
            <div class="row justify-content-center text-center">
                <div class="col-lg-8">
                    <h1 class="display-4 fw-bold mb-3">About LocalEvent</h1>
                    <p class="lead">Connecting communities through meaningful events</p>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Mission Section -->
    <section class="py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-4 mb-lg-0">
                    <h2>Our Mission</h2>
                    <p class="lead">LocalEvent is a community platform designed to bring people together through shared interests and experiences.</p>
                    <p>We believe that strong, connected communities create a better world. Our mission is to make it easy for people to discover, create, and participate in local events that matter to them.</p>
                    <p>Whether you're looking to attend a workshop, join a sports activity, or organize a neighborhood gathering, LocalEvent provides the tools and platform to make it happen.</p>
                </div>
                <div class="col-lg-6">
                    <img src="https://source.unsplash.com/random/600x400/?community" class="img-fluid rounded shadow" alt="Our Mission">
                </div>
            </div>
        </div>
    </section>
    
    <!-- Features Section -->
    <section class="py-5 bg-light">
        <div class="container">
            <h2 class="text-center mb-5">What We Offer</h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="mb-3">
                                <i class="bi bi-search fs-1 text-primary"></i>
                            </div>
                            <h4>Discover Events</h4>
                            <p>Find events that match your interests, location, and schedule with our powerful search and filter tools.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="mb-3">
                                <i class="bi bi-calendar-plus fs-1 text-primary"></i>
                            </div>
                            <h4>Create & Organize</h4>
                            <p>Easily create and manage your own events with our user-friendly tools and promotional features.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="mb-3">
                                <i class="bi bi-people fs-1 text-primary"></i>
                            </div>
                            <h4>Connect With Others</h4>
                            <p>Meet new people, build relationships, and strengthen your community through shared experiences.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Team Section -->
    <section class="py-5">
        <div class="container">
            <h2 class="text-center mb-5">Our Team</h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <img src="https://source.unsplash.com/random/300x300/?portrait,woman" class="card-img-top" alt="Team Member">
                        <div class="card-body text-center">
                            <h5 class="card-title">Sarah Johnson</h5>
                            <p class="text-muted">Founder & CEO</p>
                            <p>Passionate about bringing communities together through meaningful events.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <img src="https://source.unsplash.com/random/300x300/?portrait,man" class="card-img-top" alt="Team Member">
                        <div class="card-body text-center">
                            <h5 class="card-title">Michael Chen</h5>
                            <p class="text-muted">CTO</p>
                            <p>Technology expert with a vision for creating intuitive, user-friendly platforms.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <img src="https://source.unsplash.com/random/300x300/?portrait,person" class="card-img-top" alt="Team Member">
                        <div class="card-body text-center">
                            <h5 class="card-title">Olivia Martinez</h5>
                            <p class="text-muted">Community Manager</p>
                            <p>Dedicated to fostering vibrant communities and supporting event organizers.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Contact Section -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center">
                    <h2 class="mb-4">Get In Touch</h2>
                    <p class="lead mb-5">Have questions or feedback? We'd love to hear from you!</p>
                    <div class="row">
                        <div class="col-md-4 mb-4 mb-md-0">
                            <div class="d-flex flex-column align-items-center">
                                <div class="mb-3 fs-2 text-primary">
                                    <i class="bi bi-envelope-fill"></i>
                                </div>
                                <h5>Email Us</h5>
                                <p class="text-muted">contact@localevent.com</p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-4 mb-md-0">
                            <div class="d-flex flex-column align-items-center">
                                <div class="mb-3 fs-2 text-primary">
                                    <i class="bi bi-telephone-fill"></i>
                                </div>
                                <h5>Call Us</h5>
                                <p class="text-muted">+1 (123) 456-7890</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex flex-column align-items-center">
                                <div class="mb-3 fs-2 text-primary">
                                    <i class="bi bi-geo-alt-fill"></i>
                                </div>
                                <h5>Visit Us</h5>
                                <p class="text-muted">123 Event Street, City, Country</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
