{% extends 'base.html.twig' %}

{% block title %}LocalEvent - Find and Join Local Community Events{% endblock %}

{% block body %}
    <!-- Hero Section -->
    <section class="hero-section text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-10 col-lg-8">
                    <h1 class="display-4 fw-bold mb-3">Discover Local Events</h1>
                    <p class="lead mb-4">Find events happening in your community, meet new people, and have fun!</p>
                    {% if not app.user %}
                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                            <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg px-4 gap-3">Sign Up</a>
                            <a href="{{ path('app_login') }}" class="btn btn-outline-light btn-lg px-4">Login</a>
                        </div>
                    {% else %}
                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                            <a href="{{ path('event_new') }}" class="btn btn-primary btn-lg px-4 gap-3">Create Event</a>
                            <a href="{{ path('app_dashboard') }}" class="btn btn-outline-light btn-lg px-4">My Dashboard</a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
    
    <!-- Filter Section -->
    <section class="bg-light py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title mb-3">Find Events</h5>
                            <form action="{{ path('app_home') }}" method="get" class="row g-3">
                                <div class="col-md-4">
                                    <label for="category" class="form-label">Category</label>
                                    <select name="category" id="category" class="form-select">
                                        <option value="">All Categories</option>
                                        {% for category in categories %}
                                            <option value="{{ category.id }}" {% if app.request.query.get('category') == category.id %}selected{% endif %}>
                                                {{ category.name }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label for="location" class="form-label">Location</label>
                                    <input type="text" class="form-control" id="location" name="location" 
                                           placeholder="Enter location" value="{{ app.request.query.get('location') }}">
                                </div>
                                <div class="col-md-4">
                                    <label for="date" class="form-label">Date</label>
                                    <input type="date" class="form-control" id="date" name="date" 
                                           value="{{ app.request.query.get('date') }}">
                                </div>
                                <div class="col-12 text-end">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-search me-1"></i> Search
                                    </button>
                                    {% if app.request.query.count > 0 %}
                                        <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">
                                            <i class="bi bi-x-circle me-1"></i> Clear
                                        </a>
                                    {% endif %}
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Events Section -->
    <section class="py-5">
        <div class="container">
            <div class="row mb-4">
                <div class="col-md-8">
                    <h2 class="mb-0">
                        {% if app.request.query.count > 0 %}
                            Search Results
                        {% else %}
                            Upcoming Events
                        {% endif %}
                    </h2>
                </div>
                <div class="col-md-4 text-md-end">
                    <a href="{{ path('event_index') }}" class="btn btn-outline-primary">View All Events</a>
                </div>
            </div>
            
            <div class="row g-4">
                {% if events|length > 0 %}
                    {% for event in events %}
                        <div class="col-md-6 col-lg-4">
                            <div class="card event-card shadow-sm h-100">
                                {% if event.image %}
                                    <img src="{{ vich_uploader_asset(event, 'imageFile') }}" class="card-img-top" alt="{{ event.title }}" style="height: 200px; object-fit: cover;">
                                {% else %}
                                    <div class="bg-light text-center py-5">
                                        <i class="bi bi-calendar-event display-4 text-muted"></i>
                                    </div>
                                {% endif %}
                                <div class="card-body d-flex flex-column">
                                    <div class="mb-2">
                                        {% if event.categories|length > 0 %}
                                            <span class="badge bg-primary">{{ event.categories.first.name }}</span>
                                        {% endif %}
                                        <small class="text-muted ms-2">
                                            <i class="bi bi-calendar me-1"></i>{{ event.date|date('M d, Y') }}
                                        </small>
                                    </div>
                                    <h5 class="card-title">{{ event.title }}</h5>
                                    <p class="card-text text-truncate">{{ event.description }}</p>
                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <small class="text-muted">
                                                <i class="bi bi-geo-alt me-1"></i>{{ event.location }}
                                            </small>
                                            <a href="{{ path('event_show', {'id': event.id}) }}" class="btn btn-sm btn-primary">
                                                View Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="col-12">
                        <div class="alert alert-info">
                            <p class="mb-0 text-center">No events found. Try changing your search criteria.</p>
                        </div>
                    </div>
                {% endif %}
            </div>
            
            <!-- Pagination -->
            <div class="d-flex justify-content-center mt-4">
                {{ knp_pagination_render(events) }}
            </div>
        </div>
    </section>
    
    <!-- Categories Section -->
    <section class="py-5 bg-light">
        <div class="container">
            <h2 class="text-center mb-4">Browse by Category</h2>
            <div class="row g-3 justify-content-center">
                {% for category in categories %}
                    <div class="col-6 col-md-4 col-lg-2">
                        <a href="{{ path('event_by_category', {'id': category.id}) }}" class="text-decoration-none">
                            <div class="card text-center h-100">
                                <div class="card-body">
                                    <i class="bi bi-tag fs-3 mb-2 text-primary"></i>
                                    <h5 class="card-title">{{ category.name }}</h5>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
    
    <!-- Join Us Section -->
    <section class="py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-4 mb-lg-0">
                    <h2>Ready to Host Your Own Event?</h2>
                    <p class="lead">Join our community and start creating your own events. Connect with people who share your interests.</p>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Create events for free</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Promote to our community</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Manage attendees easily</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Send notifications automatically</li>
                    </ul>
                    <div class="mt-4">
                        {% if app.user %}
                            <a href="{{ path('event_new') }}" class="btn btn-primary btn-lg">Create an Event</a>
                        {% else %}
                            <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg">Sign Up Now</a>
                        {% endif %}
                    </div>
                </div>
                <div class="col-lg-6">
                    <img src="https://source.unsplash.com/random/600x400/?event" class="img-fluid rounded shadow" alt="Create an event">
                </div>
            </div>
        </div>
    </section>
{% endblock %}
