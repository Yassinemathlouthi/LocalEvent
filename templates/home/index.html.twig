{% extends 'base.html.twig' %}

{% block title %}LocalEvent - Find and Join Local Community Events{% endblock %}

{% block body %}
    <!-- Hero Section -->
    <section class="hero-section text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-10 col-lg-8">
                    <h1 class="display-4 fw-bold mb-3">Discover Local Events</h1>
                    <p class="lead mb-4">Find events happening in your community, meet new people, and have fun!</p>
                    {% if not app.user %}
                        <div class="d-flex justify-content-center gap-3">
                            <a href="{{ path('app_register') }}" class="btn btn-primary">Sign Up</a>
                            <a href="{{ path('app_login') }}" class="btn btn-outline">Login</a>
                        </div>
                    {% else %}
                        <div class="d-flex justify-content-center gap-3">
                            <a href="{{ path('event_new') }}" class="btn btn-primary">Create Event</a>
                            <a href="{{ path('app_dashboard') }}" class="btn btn-outline">My Dashboard</a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
    
    <!-- Filter Section -->
    <section class="py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="glass-card animate-on-scroll">
                        <h4 class="text-gradient mb-4">
                            <i class="bi bi-search me-2"></i> Find Events
                        </h4>
                        <form action="{{ path('app_home') }}" method="get" id="event-search-form" class="modern-form">
                            <div class="row g-4">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="category" class="form-label">Category</label>
                                        <select name="category" id="category" class="form-control">
                                            <option value="">All Categories</option>
                                            {% for category in categories %}
                                                <option value="{{ category.id }}" {% if app.request.query.get('category') == category.id %}selected{% endif %}>
                                                    {{ category.name }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="location" class="form-label">Location</label>
                                        <div class="input-with-icon">
                                            <i class="bi bi-geo-alt text-primary"></i>
                                            <input type="text" class="form-control" id="location" name="location" 
                                                placeholder="Enter location" value="{{ app.request.query.get('location') }}">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="date" class="form-label">Date (on or after)</label>
                                        <div class="input-with-icon">
                                            <i class="bi bi-calendar text-primary"></i>
                                            <input type="date" class="form-control" id="date" name="date" 
                                                value="{{ app.request.query.get('date') }}">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mt-4">
                                <div class="alert alert-info bg-blue-50 d-none animate-on-scroll" id="search-validation-message">
                                    <div class="d-flex">
                                        <div class="me-3">
                                            <i class="bi bi-info-circle text-info fs-4"></i>
                                        </div>
                                        <div>
                                            Please enter at least one search criteria (category, location, or date).
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="d-flex justify-content-end mt-4 gap-2">
                                {% if app.request.query.count > 0 %}
                                    <a href="{{ path('app_home') }}" class="btn btn-outline ripple">
                                        <i class="bi bi-x-circle me-1"></i> Clear
                                    </a>
                                {% endif %}
                                <button type="submit" class="btn btn-primary ripple" id="search-button">
                                    <i class="bi bi-search me-1"></i> Search
                                </button>
                            </div>
                        </form>

                        <script>
                            document.addEventListener('DOMContentLoaded', function() {
                                // Get form elements
                                const form = document.getElementById('event-search-form');
                                const categoryInput = document.getElementById('category');
                                const locationInput = document.getElementById('location');
                                const dateInput = document.getElementById('date');
                                const validationMessage = document.getElementById('search-validation-message');
                                
                                // Add form submit event listener
                                form.addEventListener('submit', function(event) {
                                    // Check if at least one field has a value
                                    if (categoryInput.value === '' && 
                                        locationInput.value === '' && 
                                        dateInput.value === '') {
                                        
                                        // Prevent form submission
                                        event.preventDefault();
                                        
                                        // Show validation message with animation
                                        validationMessage.classList.remove('d-none');
                                        validationMessage.style.opacity = 0;
                                        validationMessage.style.transform = 'translateY(-10px)';
                                        
                                        setTimeout(() => {
                                            validationMessage.style.transition = 'all 0.3s ease';
                                            validationMessage.style.opacity = 1;
                                            validationMessage.style.transform = 'translateY(0)';
                                        }, 10);
                                    }
                                });
                                
                                // Hide validation message when any input gets focus
                                [categoryInput, locationInput, dateInput].forEach(input => {
                                    input.addEventListener('focus', function() {
                                        validationMessage.classList.add('d-none');
                                    });
                                });
                                
                                // Add ripple effect to search button
                                const searchButton = document.getElementById('search-button');
                                searchButton.addEventListener('click', function(e) {
                                    if (categoryInput.value === '' && 
                                        locationInput.value === '' && 
                                        dateInput.value === '') {
                                        return; // Don't show ripple if validation will fail
                                    }
                                    
                                    const rect = this.getBoundingClientRect();
                                    const size = Math.max(rect.width, rect.height);
                                    const x = e.clientX - rect.left - size / 2;
                                    const y = e.clientY - rect.top - size / 2;
                                    
                                    const ripple = document.createElement('span');
                                    ripple.className = 'ripple-effect';
                                    ripple.style.width = ripple.style.height = `${size}px`;
                                    ripple.style.left = `${x}px`;
                                    ripple.style.top = `${y}px`;
                                    
                                    this.appendChild(ripple);
                                    
                                    setTimeout(() => {
                                        ripple.remove();
                                    }, 600);
                                });
                            });
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Events Section -->
    <section class="py-5">
        <div class="container">
            <div class="row mb-4">
                <div class="col-md-8">
                    <h2 class="mb-0">
                        {% if app.request.query.count > 0 %}
                            Search Results
                        {% else %}
                            Upcoming Events
                        {% endif %}
                    </h2>
                </div>
                <div class="col-md-4 text-md-end">
                    <a href="{{ path('event_index') }}" class="btn btn-outline">View All Events</a>
                </div>
            </div>
            
            <div class="row g-4">
                {% if events|length > 0 %}
                    {% for event in events %}
                        {% set eventPassed = event.date < date() %}
                        <div class="col-md-6 col-lg-4">
                            <div class="card event-card h-100 {% if eventPassed %}bg-light{% endif %}">
                                {% if event.image %}
                                    <img src="{{ vich_uploader_asset(event, 'imageFile') }}" class="card-img-top" alt="{{ event.title }}" style="height: 200px; object-fit: cover;">
                                {% else %}
                                    <div class="bg-light text-center py-5">
                                        <i class="bi bi-calendar-event display-4 text-muted"></i>
                                    </div>
                                {% endif %}
                                
                                {% if eventPassed %}
                                    <div class="badge bg-secondary position-absolute end-0 mt-2 me-2">Event Ended</div>
                                {% endif %}
                                
                                <div class="card-body d-flex flex-column">
                                    <div class="mb-2">
                                        {% if event.categories|length > 0 %}
                                            <span class="badge primary">{{ event.categories.first.name }}</span>
                                        {% endif %}
                                        <small class="text-muted ms-2">
                                            <i class="bi bi-calendar me-1"></i>{{ event.date|date('M d, Y') }}
                                        </small>
                                    </div>
                                    <h5 class="card-title">{{ event.title }}</h5>
                                    <p class="card-text text-truncate">{{ event.description }}</p>
                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <small class="text-muted">
                                                <i class="bi bi-geo-alt me-1"></i>{{ event.location }}
                                            </small>
                                        </div>
                                        <div class="mt-2 d-flex gap-2">
                                            <a href="{{ path('event_show', {'id': event.id}) }}" class="btn btn-outline btn-sm flex-grow-1">
                                                View Details
                                            </a>
                                            {% if is_granted('ROLE_USER') and app.user != event.organizer and not eventPassed %}
                                                <form method="post" action="{{ path('event_join', {'id': event.id}) }}" class="flex-grow-1">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('join' ~ event.id) }}">
                                                    <button type="submit" class="btn btn-primary btn-sm w-100">
                                                        <i class="bi bi-calendar-check"></i> Join
                                                    </button>
                                                </form>
                                            {% elseif not is_granted('ROLE_USER') and not eventPassed %}
                                                <a href="{{ path('app_login') }}" class="btn btn-primary btn-sm flex-grow-1">
                                                    <i class="bi bi-box-arrow-in-right"></i> Login to Join
                                                </a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="col-12">
                        <div class="alert info">
                            <p class="mb-0 text-center">No events found. Try changing your search criteria.</p>
                        </div>
                    </div>
                {% endif %}
            </div>
            
            <!-- Pagination -->
            <div class="d-flex justify-content-center mt-4">
                {{ knp_pagination_render(events) }}
            </div>
        </div>
    </section>
    
    <!-- Categories Section -->
    <section class="py-5 bg-light">
        <div class="container">
            <h2 class="text-center mb-4">Browse by Category</h2>
            <div class="row g-3 justify-content-center">
                {% for category in categories %}
                    <div class="col-6 col-md-4 col-lg-2">
                        <a href="{{ path('event_by_category', {'id': category.id}) }}" class="text-decoration-none">
                            <div class="card text-center h-100">
                                <div class="card-body">
                                    <i class="bi bi-tag fs-3 mb-2 text-primary"></i>
                                    <h5 class="card-title">{{ category.name }}</h5>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
    
    <!-- Join Us Section -->
    <section class="py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-4 mb-lg-0">
                    <h2>Ready to Host Your Own Event?</h2>
                    <p class="lead">Join our community and start creating your own events. Connect with people who share your interests.</p>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Create events for free</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Promote to our community</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Manage attendees easily</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Send notifications automatically</li>
                    </ul>
                    <div class="mt-4">
                        {% if app.user %}
                            <a href="{{ path('event_new') }}" class="btn btn-primary btn-lg">Create an Event</a>
                        {% else %}
                            <a href="{{ path('app_register') }}" class="btn btn-primary">Sign Up Now</a>
                            <a href="{{ path('app_login') }}" class="btn btn-outline ml-2">Login</a>
                        {% endif %}
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card shadow">
                        <div class="card-body p-4">
                            <h4 class="mb-3">Host your first event in minutes</h4>
                            <ol class="custom-list">
                                <li>Create a free account</li>
                                <li>Set up your event details</li>
                                <li>Share with your community</li>
                                <li>Manage RSVPs and attendees</li>
                            </ol>
                            <div class="text-center mt-4">
                                <img src="{{ asset('assets/img/event-illustration.svg') }}" alt="Event hosting" class="img-fluid" style="max-height: 200px;" onerror="this.style.display='none'">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
