{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} Events - LocalEvent{% endblock %}

{% block body %}
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row">
                <div class="col-md-8">
                    <h1 class="mb-4">{{ category.name }} Events</h1>
                </div>
                <div class="col-md-4 text-md-end">
                    <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i> Back to Home
                    </a>
                </div>
            </div>
        </div>
    </section>
    
    <section class="py-5">
        <div class="container">
            {% if events|length > 0 %}
                <div class="row g-4">
                    {% for event in events %}
                        <div class="col-md-6 col-lg-4">
                            <div class="card event-card shadow-sm h-100">
                                {% if event.image %}
                                    <img src="{{ event.image }}" class="card-img-top" alt="{{ event.title }}" style="height: 200px; object-fit: cover;">
                                {% else %}
                                    <div class="bg-light text-center py-5">
                                        <i class="bi bi-calendar-event display-4 text-muted"></i>
                                    </div>
                                {% endif %}
                                <div class="card-body d-flex flex-column">
                                    <div class="mb-2">
                                        {% if event.categories|length > 0 %}
                                            <span class="badge bg-primary">{{ event.categories.first.name }}</span>
                                        {% endif %}
                                        <small class="text-muted ms-2">
                                            <i class="bi bi-calendar me-1"></i>{{ event.date|date('M d, Y') }}
                                        </small>
                                    </div>
                                    <h5 class="card-title">{{ event.title }}</h5>
                                    <p class="card-text text-truncate">{{ event.description }}</p>
                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <small class="text-muted">
                                                <i class="bi bi-geo-alt me-1"></i>{{ event.location }}
                                            </small>
                                            <a href="{{ path('event_show', {'id': event.id}) }}" class="btn btn-sm btn-primary">
                                                View Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="alert alert-info">
                    <p class="mb-0 text-center">No events found in this category.</p>
                </div>
                <div class="text-center mt-4">
                    <a href="{{ path('event_new') }}" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i> Create an Event
                    </a>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %} 