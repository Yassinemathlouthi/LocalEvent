{% extends 'base.html.twig' %}

{% block title %}All Events - LocalEvent{% endblock %}

{% block body %}
    <!-- Events Header Section -->
    <section class="bg-primary text-white py-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="mb-0">All Events</h1>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    {% if is_granted('ROLE_USER') %}
                        <a href="{{ path('event_new') }}" class="btn btn-light">
                            <i class="bi bi-plus-circle me-1"></i> Create Event
                        </a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn btn-light">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Login to Create Event
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>

    <!-- Events List Section -->
    <section class="py-5">
        <div class="container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
            
            {% if events|length > 0 %}
                <div class="row g-4">
                    {% for event in events %}
                        {% set eventPassed = event.date < date() %}
                        <div class="col-md-6 col-lg-4">
                            <div class="card event-card shadow-sm h-100 {% if eventPassed %}bg-light{% endif %}">
                                {% if event.image %}
                                    <img src="{{ vich_uploader_asset(event, 'imageFile') }}" class="card-img-top" alt="{{ event.title }}" style="height: 200px; object-fit: cover;">
                                {% else %}
                                    <div class="bg-light text-center py-5">
                                        <i class="bi bi-calendar-event display-4 text-muted"></i>
                                    </div>
                                {% endif %}
                                
                                {% if eventPassed %}
                                    <div class="badge bg-secondary position-absolute end-0 mt-2 me-2">Event Ended</div>
                                {% endif %}
                                
                                <div class="card-body d-flex flex-column">
                                    <div class="mb-2">
                                        <div class="mb-3">
                                            {% if event.categories|length > 0 %}
                                                {% for category in event.categories %}
                                                    <span class="badge bg-primary">{{ category.name }}</span>
                                                {% endfor %}
                                            {% else %}
                                                <span class="badge bg-secondary">Uncategorized</span>
                                            {% endif %}
                                        </div>
                                        <small class="text-muted ms-2">
                                            <i class="bi bi-calendar me-1"></i>{{ event.date|date('M d, Y') }}
                                        </small>
                                    </div>
                                    <h5 class="card-title">{{ event.title }}</h5>
                                    <p class="card-text text-truncate">{{ event.description }}</p>
                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <small class="text-muted">
                                                <i class="bi bi-geo-alt me-1"></i>{{ event.location }}
                                            </small>
                                        </div>
                                        <div class="mt-2 d-flex gap-2">
                                            <a href="{{ path('event_show', {'id': event.id}) }}" class="btn btn-sm btn-outline-primary flex-grow-1">
                                                View Details
                                            </a>
                                            {% if is_granted('ROLE_USER') and app.user != event.organizer and not eventPassed %}
                                                <form method="post" action="{{ path('event_join', {'id': event.id}) }}" class="flex-grow-1">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('join' ~ event.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-primary w-100">
                                                        <i class="bi bi-calendar-check"></i> Join
                                                    </button>
                                                </form>
                                            {% elseif not is_granted('ROLE_USER') and not eventPassed %}
                                                <a href="{{ path('app_login') }}" class="btn btn-sm btn-primary flex-grow-1">
                                                    <i class="bi bi-box-arrow-in-right"></i> Login to Join
                                                </a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="alert alert-info">
                    <p class="mb-0 text-center">No events found.</p>
                </div>
                <div class="text-center mt-4">
                    <a href="{{ path('event_new') }}" class="btn btn-primary">Create the first event</a>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
