<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}LocalEvent{% endblock %}</title>
    <style>
        /* Reset styles */
        body, html {
            margin: 0;
            padding: 0;
            font-family: Arial, Helvetica, sans-serif;
            line-height: 1.6;
            color: #333;
        }
        
        /* Container */
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            background-color: #f9f9f9;
        }
        
        /* Header */
        .email-header {
            background-color: #4e73df;
            color: white;
            padding: 20px;
            text-align: center;
            border-radius: 5px 5px 0 0;
        }
        
        .email-header h1 {
            margin: 0;
            font-size: 24px;
        }
        
        /* Content */
        .email-content {
            background-color: white;
            padding: 30px;
            border-radius: 0 0 5px 5px;
            border: 1px solid #eee;
            border-top: none;
        }
        
        h2 {
            color: #4e73df;
            margin-top: 0;
        }
        
        /* Event Card */
        .event-card {
            background-color: #f8f9fc;
            border: 1px solid #e3e6f0;
            border-radius: 5px;
            padding: 15px;
            margin: 20px 0;
        }
        
        .event-card h3 {
            margin-top: 0;
            color: #2e59d9;
        }
        
        /* Button */
        .cta-button {
            text-align: center;
            margin: 30px 0;
        }
        
        .button {
            display: inline-block;
            background-color: #4e73df;
            color: white;
            padding: 12px 20px;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
        }
        
        /* Footer */
        .email-footer {
            text-align: center;
            padding-top: 20px;
            font-size: 12px;
            color: #666;
        }
        
        .social-links {
            margin: 15px 0;
        }
        
        .social-links a {
            margin: 0 5px;
            color: #4e73df;
            text-decoration: none;
        }
        
        .note {
            font-size: 14px;
            font-style: italic;
            color: #666;
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="email-header">
            <h1>LocalEvent</h1>
        </div>
        
        {% block content %}{% endblock %}
        
        <div class="email-footer">
            <div class="social-links">
                <a href="#">Facebook</a> | 
                <a href="#">Twitter</a> | 
                <a href="#">Instagram</a>
            </div>
            <p>© {{ "now"|date("Y") }} LocalEvent. All rights reserved.</p>
            <p>You are receiving this email because you are registered on LocalEvent.</p>
        </div>
    </div>
</body>
</html> 