{% extends 'base.html.twig' %}

{% block title %}Change Password - LocalEvent{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h3 class="card-title mb-0">Change Password</h3>
                    </div>
                    <div class="card-body">
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {% endfor %}
                        
                        {% for message in app.flashes('danger') %}
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {% endfor %}
                        
                        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                            <div class="mb-4">
                                <div class="form-floating">
                                    {{ form_widget(form.currentPassword, {'attr': {'class': 'form-control', 'placeholder': 'Current Password'}}) }}
                                    {{ form_label(form.currentPassword) }}
                                    {% if form_errors(form.currentPassword) %}
                                        <div class="invalid-feedback d-block">
                                            {{ form_errors(form.currentPassword) }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                            
                            <div class="mb-4">
                                <div class="form-floating">
                                    {{ form_widget(form.newPassword.first, {'attr': {'class': 'form-control', 'placeholder': 'New Password'}}) }}
                                    {{ form_label(form.newPassword.first) }}
                                    {% if form_errors(form.newPassword.first) %}
                                        <div class="invalid-feedback d-block">
                                            {{ form_errors(form.newPassword.first) }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                            
                            <div class="mb-4">
                                <div class="form-floating">
                                    {{ form_widget(form.newPassword.second, {'attr': {'class': 'form-control', 'placeholder': 'Confirm New Password'}}) }}
                                    {{ form_label(form.newPassword.second) }}
                                    {% if form_errors(form.newPassword.second) %}
                                        <div class="invalid-feedback d-block">
                                            {{ form_errors(form.newPassword.second) }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                            
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-shield-lock me-2"></i> Update Password
                                </button>
                            </div>
                        {{ form_end(form) }}
                        
                        <div class="mt-4 text-center">
                            <a href="{{ path('app_profile') }}" class="btn btn-link">
                                <i class="bi bi-arrow-left me-1"></i> Back to Profile
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="card mt-4 shadow-sm">
                    <div class="card-body">
                        <h5><i class="bi bi-info-circle-fill text-primary me-2"></i> Password Requirements</h5>
                        <ul class="mb-0">
                            <li>Minimum 6 characters in length</li>
                            <li>Include a mix of letters, numbers, and special characters for stronger security</li>
                            <li>Avoid using common words, phrases, or personal information</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %} 