{% extends 'base.html.twig' %}

{% block title %}Reset Password - LocalEvent{% endblock %}

{% block body %}
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h3 class="card-title mb-0">Reset Your Password</h3>
                    </div>
                    <div class="card-body">
                        {% for flash_error in app.flashes('reset_password_error') %}
                            <div class="alert alert-danger" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                {{ flash_error }}
                            </div>
                        {% endfor %}
                        
                        <p class="mb-4">Enter your email address and we will send you a link to reset your password.</p>
                        
                        {{ form_start(requestForm, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                            <div class="mb-4">
                                <div class="form-floating">
                                    {{ form_widget(requestForm.email, {'attr': {'class': 'form-control', 'placeholder': 'Email'}}) }}
                                    {{ form_label(requestForm.email) }}
                                    {% if form_errors(requestForm.email) %}
                                        <div class="invalid-feedback d-block">
                                            {{ form_errors(requestForm.email) }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                            
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-envelope me-2"></i> Send Password Reset Email
                                </button>
                            </div>
                        {{ form_end(requestForm) }}
                        
                        <div class="mt-4 text-center">
                            <a href="{{ path('app_login') }}" class="btn btn-link">
                                <i class="bi bi-arrow-left me-1"></i> Back to login
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %} 