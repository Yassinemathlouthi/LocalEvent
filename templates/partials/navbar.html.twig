<header class="navbar-container">
    <div class="container">
        <nav class="navbar">
            <a href="{{ path('app_home') }}" class="navbar-brand">
                <span class="text-gradient">Local</span><span class="text-bold">Event</span>
            </a>
            
            <div class="navbar-menu">
                <a href="{{ path('app_home') }}" class="nav-link {% if app.request.get('_route') == 'app_home' %}active{% endif %}">
                    <i class="bi bi-house"></i>
                    <span>Home</span>
                </a>
                
                <a href="{{ path('event_index') }}" class="nav-link {% if app.request.get('_route') starts with 'event_' and app.request.get('_route') != 'event_new' %}active{% endif %}">
                    <i class="bi bi-calendar-event"></i>
                    <span>Events</span>
                </a>
                
                <a href="#categories" class="nav-link">
                    <i class="bi bi-grid"></i>
                    <span>Categories</span>
                </a>
                
                <a href="#about" class="nav-link">
                    <i class="bi bi-info-circle"></i>
                    <span>About</span>
                </a>
            </div>
            
            <div class="navbar-right">
                <button class="dark-mode-toggle" aria-label="Toggle dark mode">
                    <i class="bi bi-moon"></i>
                    <i class="bi bi-sun"></i>
                </button>
                
                {% if app.user %}
                    <a href="{{ path('event_new') }}" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-circle"></i>
                        <span>Create Event</span>
                    </a>
                    
                    <div class="user-dropdown">
                        <button class="user-menu-toggle ripple" aria-expanded="false">
                            {% if app.user.profilePicture is defined and app.user.profilePicture %}
                                <img src="{{ asset('uploads/profile/' ~ app.user.profilePicture) }}" alt="{{ app.user.name ?? app.user.email }}">
                            {% else %}
                                <div class="avatar-placeholder pulse">
                                    {{ app.user.name|default(app.user.email)|slice(0, 1)|upper }}
                                </div>
                            {% endif %}
                        </button>
                        <div class="dropdown-menu">
                            <div class="dropdown-header">
                                <strong>{{ app.user.name ?? app.user.email }}</strong>
                                <span>{{ app.user.email }}</span>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a href="{{ path('app_dashboard') }}" class="dropdown-item">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                            <a href="{{ path('app_profile') }}" class="dropdown-item">
                                <i class="bi bi-person"></i> Profile
                            </a>
                            <a href="{{ path('app_my_events') }}" class="dropdown-item">
                                <i class="bi bi-calendar-check"></i> My Events
                            </a>
                            <a href="{{ path('app_attending') }}" class="dropdown-item">
                                <i class="bi bi-calendar-heart"></i> Attending
                            </a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <div class="dropdown-divider"></div>
                                <a href="{{ path('admin_dashboard') }}" class="dropdown-item">
                                    <i class="bi bi-gear"></i> Admin Panel
                                </a>
                            {% endif %}
                            <div class="dropdown-divider"></div>
                            <a href="{{ path('app_logout') }}" class="dropdown-item text-danger">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </a>
                        </div>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-ghost">Log in</a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary">Sign up</a>
                {% endif %}
            </div>
            
            <button class="navbar-mobile-toggle" aria-expanded="false" aria-label="Toggle navigation">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </nav>
    </div>
</header>
