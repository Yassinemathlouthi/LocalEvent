<footer class="footer mt-auto">
    <div class="container">
        <div class="row">
            <div class="col-md-4 mb-4 mb-md-0">
                <h5 class="mb-3">LocalEvent</h5>
                <p>Discover and join amazing events happening in your community. Create your own events and connect with like-minded people.</p>
            </div>
            <div class="col-md-2 mb-4 mb-md-0">
                <h5 class="mb-3">Links</h5>
                <ul class="list-unstyled">
                    <li class="mb-2"><a href="{{ path('app_home') }}" class="text-decoration-none text-white">Home</a></li>
                    <li class="mb-2"><a href="{{ path('event_index') }}" class="text-decoration-none text-white">Events</a></li>
                    <li class="mb-2"><a href="{{ path('app_about') }}" class="text-decoration-none text-white">About Us</a></li>
                </ul>
            </div>
            <div class="col-md-3 mb-4 mb-md-0">
                <h5 class="mb-3">Account</h5>
                <ul class="list-unstyled">
                    {% if app.user %}
                        <li class="mb-2"><a href="{{ path('app_dashboard') }}" class="text-decoration-none text-white">My Dashboard</a></li>
                        <li class="mb-2"><a href="{{ path('app_profile') }}" class="text-decoration-none text-white">Profile</a></li>
                        <li class="mb-2"><a href="{{ path('event_new') }}" class="text-decoration-none text-white">Create Event</a></li>
                    {% else %}
                        <li class="mb-2"><a href="{{ path('app_login') }}" class="text-decoration-none text-white">Log In</a></li>
                        <li class="mb-2"><a href="{{ path('app_register') }}" class="text-decoration-none text-white">Sign Up</a></li>
                    {% endif %}
                </ul>
            </div>
            <div class="col-md-3">
                <h5 class="mb-3">Connect With Us</h5>
                <div class="d-flex">
                    <a href="#" class="text-white me-3 fs-5"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="text-white me-3 fs-5"><i class="bi bi-twitter"></i></a>
                    <a href="#" class="text-white me-3 fs-5"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="text-white fs-5"><i class="bi bi-linkedin"></i></a>
                </div>
            </div>
        </div>
        <hr class="my-4 bg-light">
        <div class="row">
            <div class="col-md-6 text-center text-md-start">
                <p class="mb-0">&copy; {{ 'now'|date('Y') }} LocalEvent. All rights reserved.</p>
            </div>
            <div class="col-md-6 text-center text-md-end">
                <p class="mb-0">Built with <i class="bi bi-heart-fill text-danger"></i> and Symfony</p>
            </div>
        </div>
    </div>
</footer>
