<!-- Modern Dashboard Sidebar -->
<div class="dashboard-sidebar">
    <div class="user-profile mb-4">
        {% if app.user.profilePicture is defined and app.user.profilePicture %}
            <img src="{{ asset('uploads/profile/' ~ app.user.profilePicture) }}" alt="{{ app.user.name ?? app.user.email }}" class="user-avatar">
        {% else %}
            <div class="user-avatar-placeholder">
                {{ app.user.name|default(app.user.email)|slice(0, 1)|upper }}
            </div>
        {% endif %}
        <div class="user-info">
            <h4>{{ app.user.name ?? app.user.email }}</h4>
            <p>{{ app.user.email }}</p>
        </div>
    </div>
    
    <h5 class="sidebar-heading">Main Menu</h5>
    
    <div class="list-group">
        <a href="{{ path('app_dashboard') }}" class="list-group-item {% if active is defined and active == 'dashboard' %}active{% endif %}">
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
        </a>
        
        <a href="{{ path('app_my_events') }}" class="list-group-item {% if active is defined and active == 'my_events' %}active{% endif %}">
            <i class="bi bi-calendar-event"></i>
            <span>My Events</span>
            {% if myEvents is defined and myEvents|length > 0 %}
                <span class="badge">{{ myEvents|length }}</span>
            {% endif %}
        </a>
        
        <a href="{{ path('app_attending') }}" class="list-group-item {% if active is defined and active == 'attending' %}active{% endif %}">
            <i class="bi bi-person-check"></i>
            <span>Attending</span>
            {% if attendances is defined and attendances|length > 0 %}
                <span class="badge">{{ attendances|length }}</span>
            {% endif %}
        </a>
        
        <a href="{{ path('app_profile') }}" class="list-group-item {% if active is defined and active == 'profile' %}active{% endif %}">
            <i class="bi bi-person-circle"></i>
            <span>My Profile</span>
        </a>
        
        <a href="{{ path('event_new') }}" class="list-group-item highlight">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Create Event</span>
        </a>
    </div>
    
    <div class="sidebar-divider"></div>
    
    <h5 class="sidebar-heading">Quick Links</h5>
    
    <div class="list-group">
        <a href="{{ path('event_index') }}" class="list-group-item">
            <i class="bi bi-search"></i>
            <span>Browse Events</span>
        </a>
        
        <a href="{{ path('app_home') }}" class="list-group-item">
            <i class="bi bi-house"></i>
            <span>Home Page</span>
        </a>
        
        <a href="{{ path('app_logout') }}" class="list-group-item danger">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
        </a>
    </div>
</div> 